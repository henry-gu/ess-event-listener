<html>
  <%- include('partials/head') %>
  <body>
    <%- include('partials/nav') %>
    <div class="container pt-2">
      <h5>Search text <span class="text-primary fs-5">"<%= keyword %>"</span>, <%= events.length %> records found<%= truncated ? " (first 100 shown)" : "" %>.</h5>
    </div>
    <div class="container pt-2">
      <% events.forEach(function(event){ %>
      <div class="row pt-1 bg-secondary bg-gradient bg-opacity-25">
        <div class="col-11 fs-6 fw-bold align-middle">
          <button type="button" class="btn btn-secondary btn-sm"><%= event.displayTimeStamp %> UTC</button>
          <button type="button" class="btn btn-primary btn-sm"><%= event.topic %></button>
          <button type="button" class="btn btn-success btn-sm"><%= event.type %></button>
          <button type="button" class="btn btn-warning btn-sm"><%= String(event.id || "").slice(0, 40) %></button>
          <button type="button" class="btn btn-info btn-sm"><%= event.geolocation %></button>
        </div>
        <div class="col-1">
          <form class="mb-1" action="/eventdelete/<%= encodeURIComponent(event.id) %>" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
      <div class="row pt-1 pb-1 border bg-light border-light">
        <div class="col-12 align-left">
          <% const sanitizedFacts = String(event.facts || "{}").replace(/\n/g, ' '); %>
          <a href="/event/<%= encodeURIComponent(event.id) %>" role="button" class="btn btn-light btn-sm"><%= "facts: " + sanitizedFacts.slice(0, 160) + " ..." %></a>
        </div>
      </div>
      <% }) %>
      <div class="row pt-3">
        <a href="/" class="col-1 btn btn-primary" role="button">Back</a>
      </div>
    </div>
  </body>
</html>
